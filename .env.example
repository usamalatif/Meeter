# Google Meet
GOOGLE_SERVICE_ACCOUNT_PATH=./credentials/google-service-account.json
GOOGLE_DELEGATED_EMAIL=admin@yourcompany.com

# Zoom
ZOOM_SDK_KEY=your_zoom_sdk_key
ZOOM_SDK_SECRET=your_zoom_sdk_secret

# Deepgram
DEEPGRAM_API_KEY=your_deepgram_key

# OpenAI (Agent Brain + TTS)
OPENAI_API_KEY=your_openai_key

# Database
DATABASE_URL=postgresql://user:pass@localhost:5432/meeting_agent
REDIS_URL=redis://localhost:6379

# Auth
CLERK_SECRET_KEY=your_clerk_secret
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=your_clerk_publishable

# Stripe
STRIPE_SECRET_KEY=your_stripe_secret
STRIPE_WEBHOOK_SECRET=your_webhook_secret

# Integrations (OAuth app credentials — not user tokens)
JIRA_CLIENT_ID=your_jira_oauth_client_id
JIRA_CLIENT_SECRET=your_jira_oauth_secret
SLACK_CLIENT_ID=your_slack_app_client_id
SLACK_CLIENT_SECRET=your_slack_app_secret

# App
PORT=3001
NODE_ENV=production
BOT_DISPLAY_NAME=Aria (AI Assistant)
